# ============================================================
# EngFinite Learning — SPA routing support
# ============================================================
# This site is a single-page application: one index.html file handles
# every URL (e.g. /exam/cam13/1/exam, /bandCalculator, /vocab) using
# JavaScript. Without this rule, the server would try to find a real
# file/folder at those paths and return a 404 "Not Found" error.
#
# What this does: if the requested path is NOT a real file or folder
# that actually exists on the server, silently serve index.html instead
# — the page's own JavaScript then reads the URL and shows the right
# content. Real files (data-cam13.js, images, etc.) are still served
# normally and are NOT affected by this rule.
#
# IMPORTANT: If you already have an .htaccess file in your site's root
# folder, do NOT replace it with this one — instead, ADD just the
# "RewriteEngine On" through "RewriteRule ^ index.html [L]" block below
# into your existing file (skip RewriteEngine On if it's already there).
# ============================================================

RewriteEngine On
RewriteBase /

# If the request matches a real file or folder on the server, serve it
# directly and stop here (this protects data-cam*.js, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, this is a "virtual" app route (e.g. /exam/cam13/1/exam) —
# serve index.html and let the page's JavaScript handle it.
RewriteRule ^ index.html [L]

# ============================================================
# Cache control — prevent stale content for visitors
# ============================================================
<IfModule mod_headers.c>
  # Never let index.html be cached anywhere (browser, proxy, or ISP)
  # so every visit checks the server for the latest version.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # data-*.js files are safe to cache long-term because their URLs now
  # include a ?v= version number (see index.html) that changes on every
  # content update, so browsers/proxies always fetch fresh content when
  # the version changes, and can cache aggressively otherwise.
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ============================================================
# Security (added 5 Nov 2026)
# ============================================================
# Do not list the folders on the server
Options -Indexes

# Never let anyone download setup, source or backup files by address
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(sql|ts|md|bak|log|ini|env|zip|sh)$)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Only load code and data from the places this site really uses
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: https://fhioawgwdmqybjvadrpf.supabase.co wss://fhioawgwdmqybjvadrpf.supabase.co https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; frame-src 'self' blob: https:; worker-src 'self' blob: https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Stop browsers guessing file types
  Header always set X-Content-Type-Options "nosniff"
  # Do not allow other websites to put this site inside a frame
  Header always set X-Frame-Options "SAMEORIGIN"
  # Share only the site name (not the full address) when a link is opened
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # This site never needs the camera, microphone, location or payments
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
